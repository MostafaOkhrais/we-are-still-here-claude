{
  "name": "we-are-still-here",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.cjs -i src/input.css -o public/css/tailwind.css --minify",
    "build:ar": "node scripts/build-ar.mjs",
    "build": "npm run build:ar && npm run build:css",
    "dev": "npm run build && wrangler pages dev public",
    "deploy": "npm run build && wrangler pages deploy public --project-name we-are-still-here --branch main",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "admin:create": "node scripts/create-admin.mjs",
    "seo:ping": "node scripts/indexnow.mjs"
  },
  "devDependencies": {
    "tailwindcss": "3.4.10",
    "wrangler": "^3"
  },
  "allowScripts": {
    "workerd@1.20250718.0": true,
    "esbuild@0.17.19": true
  }
}
